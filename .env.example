# Apps Script web-app /exec URL for the BetterBodies feedback + services
# endpoint. Used at build time by scripts/fetch-services.mjs to pull the
# "Public Services" sheet into src/data/services.generated.json.
#
# If unset, the prebuild script logs a warning and leaves the committed
# services.generated.json untouched (the build never breaks).
APPS_SCRIPT_URL=
